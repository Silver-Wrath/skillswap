{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm run setup",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
